# Copie ce fichier en .env.local et remplis-le. Ne commite jamais .env.local.

# Projet Supabase du QG (pas celui de l'OS).
NEXT_PUBLIC_SUPABASE_URL=https://jvptwclrlxiyzahmqbbx.supabase.co
# Clé publique (faite pour le navigateur, protégée par la RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète du projet QG : seulement pour `pnpm seed` et les routes serveur. Jamais dans le code.
SUPABASE_SECRET_KEY=

# Identifiants des 2 seuls comptes autorisés (pas forcément de vraies adresses).
ALLOWED_EMAILS=max:max-xxxx@qg-vik.local,adrien:adrien-xxxx@qg-vik.local

# Mettre 1 une fois Google activé dans Supabase (Authentication > Providers) pour afficher le bouton.
NEXT_PUBLIC_GOOGLE_AUTH=

# Connexion en un clic (provisoire). Laisser vide pour exiger le mot de passe.
QG_AUTO_LOGIN_SECRET=

# ---- Phase 2 : chiffres en direct (lecture seule). À mettre dans Vercel, jamais dans le code. ----
# Qonto : Paramètres > Intégrations > Clé API (identifiant + clé secrète).
QONTO_LOGIN=
QONTO_SECRET_KEY=
# RevenueCat : une clé secrète v2 en lecture par projet (Project settings > API keys).
REVENUECAT_KEY_SOPHIA=
REVENUECAT_KEY_MICABO=
REVENUECAT_KEY_UNSWIPE=
# Secret du rendez-vous du lundi (Vercel l'envoie tout seul). Une longue chaîne au hasard.
CRON_SECRET=
